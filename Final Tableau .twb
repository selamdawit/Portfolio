            <run fontcolor='#444e5a' fontname='Arial' fontsize='10'>Total Artworks</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#333a43' fontname='Arial'><![CDATA[<[federated.0tvs7uu1hn88hb1h24can09vgmvw].[usr:Calculation_0077374744682496:qk]>]]></run>
