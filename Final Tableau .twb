      <column caption='Artist Bio' datatype='string' name='[ArtistBio]' role='dimension' type='nominal' />
      <column caption='Begin Date' datatype='string' name='[BeginDate]' role='dimension' type='nominal' />
      <column caption='BeginDate clean' datatype='integer' default-format='n0;-0' name='[BeginDate_clean]' role='measure' type='quantitative' />
      <column caption='% On View' datatype='real' default-format='p0.00%' name='[Calculation_0033738562805761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0077374754357255] / COUNT([ObjectID])' />
      </column>
      <column caption='Cataloged %' datatype='real' default-format='p0.0%' name='[Calculation_0033738574385154]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Cataloged] = &quot;Y&quot; THEN 1 ELSE 0 END) / COUNT([ObjectID])' />
      </column>
      <column caption='Catelogued Count' datatype='integer' name='[Calculation_0033738595196931]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Cataloged] = &quot;Y&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='All' datatype='string' name='[Calculation_0033738624163847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;All&quot;' />
      </column>
      <column caption='Not On View Count' datatype='integer' name='[Calculation_0033738637783050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF ISNULL([OnView]) THEN 1 ELSE 0 END )' />
      </column>
      <column caption='Not On View %' datatype='real' default-format='p0.0%' name='[Calculation_0033738638503947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM( IF ISNULL([OnView]) THEN 1 ELSE 0 END )&#10;/ COUNT([ObjectID])' />
      </column>
      <column caption='Department Rank' datatype='integer' name='[Calculation_0033738668969996]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_DENSE(SUM(&#10;    IF ISNULL([OnView]) THEN 0 ELSE 1 END&#10;))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total On View (FIXED LOD)' datatype='integer' name='[Calculation_0033738670612493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(&#10;    IF NOT ISNULL([OnView]) AND [OnView] != &quot;&quot; THEN 1&#10;    ELSE 0&#10;END&#10;)}' />
      </column>
      <column caption='FILTER' datatype='string' name='[Calculation_0033739233349649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([OnView]) AND [OnView] != &quot;&quot; THEN &quot;On View&quot;&#10;ELSE &quot;Not On View&quot;&#10;END' />
      </column>
      <column caption='On View Flag' datatype='string' name='[Calculation_0033739247157266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([OnView]) THEN &quot;Not On View&quot;&#10;ELSE &quot;On View&quot;&#10;END' />
      </column>
      <column caption='Not On View artworks' datatype='integer' name='[Calculation_0033739247812627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ObjectID]) - [Calculation_0077374754357255]' />
      </column>
      <column caption='Group classification' datatype='string' name='[Calculation_0033739333459991]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Classification]) OR [Classification] = &quot;(not assigned)&quot; THEN &quot;Unknown&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Painting&quot;,&quot;Sculpture&quot;,&quot;Drawing&quot;,&quot;Print&quot;,&quot;Work on Paper&quot;,&quot;Collage&quot;,&quot;Multiple&quot;,&quot;Portfolio&quot;&#10;) THEN &quot;Fine Art&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Photograph&quot;,&quot;Photo Album&quot;,&quot;Photography Research/Reference&quot;&#10;) THEN &quot;Photography&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Design&quot;,&quot;Graphic Design&quot;,&quot;Poster&quot;,&quot;Illustrated Book&quot;,&quot;Publication&quot;,&quot;Periodical&quot;,&quot;Ephemera&quot;,&quot;News Clipping&quot;,&quot;Wallpaper&quot;&#10;) THEN &quot;Design &amp; Print&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Film&quot;,&quot;Film (object)&quot;,&quot;Video&quot;,&quot;Moving Image&quot;,&quot;Media&quot;,&quot;Audio&quot;,&quot;Performance&quot;&#10;) THEN &quot;Time-based Media&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Architecture&quot;,&quot;Architectural Model&quot;,&quot;Furniture and Interiors&quot;,&quot;Mies van der Rohe Archive&quot;,&quot;Frank Lloyd Wright Archive&quot;&#10;) THEN &quot;Architecture&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Digital&quot;,&quot;Software&quot;,&quot;Website&quot;,&quot;Installation&quot;&#10;) THEN &quot;Contemporary / Digital&quot;&#10;&#10;ELSEIF [Classification] IN (&#10;&quot;Document&quot;,&quot;Correspondence&quot;,&quot;Notebook&quot;&#10;) THEN &quot;Documents &amp; Archives&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;&#10;END' />
      </column>
      <column caption='Fixed Obj' datatype='integer' name='[Calculation_0033739352965148]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : COUNT([ObjectID]) }' />
      </column>
      <column caption='Square Reference' datatype='real' name='[Calculation_0033739668643870]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Width (cm)])' />
      </column>
      <column caption='Acquisition Type' datatype='string' name='[Calculation_0033739731423263]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([CreditLine]) THEN &quot;Other&quot;&#10;&#10;ELSEIF CONTAINS(LOWER([CreditLine]), &quot;purchase&quot;) &#10;    AND CONTAINS(LOWER([CreditLine]), &quot;gift&quot;) THEN &quot;Gift + Purchase&quot;&#10;&#10;ELSEIF CONTAINS(LOWER([CreditLine]), &quot;purchase&quot;) THEN &quot;Purchase&quot;&#10;&#10;ELSEIF CONTAINS(LOWER([CreditLine]), &quot;gift&quot;) &#10;    OR CONTAINS(LOWER([CreditLine]), &quot;given&quot;) THEN &quot;Gift&quot;&#10;&#10;ELSEIF CONTAINS(LOWER([CreditLine]), &quot;fund&quot;) THEN &quot;Fund&quot;&#10;&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Yearly Acquisitions' datatype='integer' name='[Calculation_0070362835259414]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [AcquiredYear] : COUNT([ObjectID]) }' />
      </column>
      <column caption='Acquisition Lag' datatype='integer' name='[Calculation_0070362862370840]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[AcquiredYear] - [artwork_year]' />
      </column>
      <column caption='Index' datatype='integer' name='[Calculation_0070362881953817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Radius' datatype='real' name='[Calculation_0070362968010797]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(LOG([Calculation_0070362862370840] + 1)) + [Parameters].[Parameter 1]' />
      </column>
      <column caption='Dept Angle' datatype='real' name='[Calculation_0070362980507701]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Department]&#10;WHEN &quot;Architecture &amp; Design&quot; THEN 0&#10;WHEN &quot;Drawings &amp; Prints&quot; THEN PI()/4&#10;WHEN &quot;Painting &amp; Sculpture&quot; THEN PI()/2&#10;WHEN &quot;Photography&quot; THEN 3*PI()/4&#10;WHEN &quot;Media and Performance&quot; THEN PI()&#10;WHEN &quot;Film&quot; THEN 5*PI()/4&#10;WHEN &quot;Architecture &amp; Design - Image Archive&quot; THEN 3*PI()/2&#10;WHEN &quot;Fluxus Collection&quot; THEN 7*PI()/4&#10;END' />
      </column>
      <column caption='Total Artworks' datatype='integer' name='[Calculation_0077374744682496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ObjectID])' />
      </column>
      <column caption='Is On View ' datatype='boolean' name='[Calculation_0077374752309253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([OnView]) AND [OnView] != &quot;&quot;' />
      </column>
      <column caption='KPI Calculation' datatype='integer' name='[Calculation_0077374752571398]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(INT([Calculation_0077374752309253]))' />
      </column>
      <column caption='On View Count' datatype='integer' name='[Calculation_0077374754357255]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF ISNULL([OnView]) THEN 0 ELSE 1 END&#10;)' />
      </column>
      <column caption='Growth Acquired 2026' datatype='real' default-format='p0.0%' name='[Calculation_0077374783401992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Comparison of Year-to-Date (YTD) 2026 vs YTD 2025&#10;(&#10;  COUNT(IF YEAR([DateAcquired_clean]) = 2026 THEN [ObjectID] END)&#10;  -&#10;  COUNT(IF YEAR([DateAcquired_clean]) = 2025 &#10;    AND [DateAcquired_clean] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()) THEN [ObjectID] END)&#10;)&#10;/&#10;COUNT(IF YEAR([DateAcquired_clean]) = 2025 &#10;  AND [DateAcquired_clean] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()) THEN [ObjectID] END)' />
      </column>
      <column caption='Current YTD Count' datatype='integer' name='[Calculation_0094075478884352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF YEAR([DateAcquired_clean]) = 2026 THEN [ObjectID] END)' />
      </column>
      <column caption='Previous YTD Count' datatype='integer' name='[Calculation_0094075478982657]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF YEAR([DateAcquired_clean]) = 2025 AND [DateAcquired_clean] &lt;= DATEADD(&apos;year&apos;, -1, TODAY()) THEN [ObjectID] END)' />
      </column>
